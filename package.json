{
  "name": "smt-z3",
  "displayName": "SMT Z3",
  "description": "VS Code extension for SMT-LIB 2.7 scripts with Z3 solver integration via WebAssembly and Language Server support (diagnostics, sort checking, completion, hover, navigation, and formatting).",
  "icon": "images/logo.png",
  "version": "5.4.101",
  "publisher": "Soaibuzzaman",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:smt"
  ],
  "main": "./out/extension/main.cjs",
  "contributes": {
    "languages": [
      {
        "id": "smt",
        "aliases": [
          "SMT-LIB",
          "SMT",
          "smt",
          "smt2",
          "smt-lib"
        ],
        "extensions": [
          ".smt2"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "smt",
        "scopeName": "source.smt",
        "path": "./syntaxes/smt.tmLanguage.json"
      }
    ],
    "configuration": [
      {
        "type": "object",
        "title": "SMT-Z3 Configuration",
        "properties": {
          "smt-z3.enableLsp": {
            "type": "boolean",
            "default": true,
            "description": "Enable the experimental SMT-LIB / Z3 Language Server (diagnostics, sort checking, completion, hover, navigation, and formatting)."
          },
          "smt-z3.timeout": {
            "type": "number",
            "default": 60000,
            "description": "Timeout in milliseconds for SMT-Z3 execution."
          },
          "smt-z3.showCurrentLineCodeLens": {
            "type": "boolean",
            "default": true,
            "description": "Show Execute/Stop CodeLens button on the current line."
          },
          "smt-z3.showSolveTime": {
            "type": "boolean",
            "default": true,
            "description": "Show the timestamp of the last solve operation and the time taken."
          }
        }
      }
    ],
    "commands": [
      {
        "command": "smt2.run",
        "title": "Execute Z3",
        "category": "SMT-Z3"
      },
      {
        "command": "smt2.stop",
        "title": "Stop Z3",
        "category": "SMT-Z3"
      },
      {
        "command": "smt2.openSettings",
        "title": "Open Settings",
        "category": "SMT-Z3"
      },
      {
        "command": "smt2.restartServer",
        "title": "Restart Language Server",
        "category": "SMT-Z3"
      }
    ]
  },
  "keywords": [
    "smt",
    "smt-lib",
    "z3",
    "smt2",
    "smt-lib-v2"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soaibsafi/smt-z3-vscode/.git"
  },
  "author": {
    "email": "soaibuzzaman@uni-weimar.de",
    "name": "Soaibuzzaman"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/soaibsafi/smt-z3-vscode/issues"
  },
  "homepage": "https://github.com/soaibsafi/smt-z3-vscode/#readme",
  "scripts": {
    "vscode:prepublish": "npm run compile:prod",
    "compile": "tsc --noEmit && node esbuild.mjs",
    "compile:prod": "tsc --noEmit && node esbuild.mjs --minify",
    "watch": "node esbuild.mjs --watch",
    "compile-tests": "tsc -p tsconfig.test.json",
    "pretest": "npm run compile && npm run compile-tests && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "~0.25.5",
    "eslint": "^9.9.1",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@se-buw/smt-language": "^0.1.0",
    "langium": "~4.1.0",
    "vscode-languageclient": "~9.0.1",
    "vscode-languageserver": "~9.0.1",
    "z3-solver": "^5.4.1"
  },
  "vsce": {
    "dependencies": false
  }
}
