{
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ES2022",
		"lib": [
			"ES2022"
		],
		"noEmit": true,
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		"skipLibCheck": true
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"src/test/**/*.ts"
	]
}
