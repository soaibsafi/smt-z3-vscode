{
    "comments": {
        "lineComment": ";",
        "blockComment": ["#|", "|#"]
    },
    "brackets": [
        ["(", ")"]
    ],
    "autoClosingPairs": [
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
        { "open": "|", "close": "|", "notIn": ["string", "comment"] }
    ],
    "surroundingPairs": [
        ["(", ")"],
        ["\"", "\""],
        ["|", "|"]
    ],
    "wordPattern": "[a-zA-Z0-9~!@$%^&*_\\-+=<>.?/,:#]+",
    "indentationRules": {
        "increaseIndentPattern": "^.*\\((?:[^()\"|;]|\"(?:[^\"]|\"\")*\"|\\|[^|]*\\|)*$",
        "decreaseIndentPattern": "^\\s*\\)"
    }
}
